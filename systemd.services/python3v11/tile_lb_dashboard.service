[Unit]
Description=Tile_LB_Dashboard (python3v11)
After=network-online.target
Wants=network-online.target


[Service]
User=root
Group=root
WorkingDirectory=/root/apps/tiledb-dataloggers/python3v11/lb_dashboard_webapp
ExecStart=/root/apps/tiledb-dataloggers/python3v11/.pyenv/bin/python app.py
Restart=always
RestartSec=5

# Optional but recommended
Environment="PYTHONUNBUFFERED=1"
Environment="VIRTUAL_ENV=/root/apps/tiledb-dataloggers/python3v11/.pyenv"
Environment="PATH=/root/apps/tiledb-dataloggers/python3v11/.pyenv/bin:/usr/bin"
Environment="LD_LIBRARY_PATH=/usr/local/lib"

[Install]
WantedBy=multi-user.target
